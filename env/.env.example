NODE_ENV=development

# NEXT JS
NEXT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# API GATEWAY
API_GATEWAY_PORT=3001

# RABBIT MQ
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_URL=amqp://guest:guest@goosee-rabbitmq-dev:5672
RABBITMQ_ERLANG_COOKIE=change-me-to-a-random-secret

# USER SERVICE
USER_SERVICE_HOST=goosee-user-service-dev
USER_SERVICE_PORT=3002

# USER DATABASE
USER_DB_HOST=goosee-user-db-dev
USER_DB_PORT=5432
USER_DB_USER=postgres
USER_DB_PASSWORD=postgres
USER_DB_NAME=user_db

# AUTH_SERVICE
AUTH_SERVICE_HOST=goosee-auth-service-dev
AUTH_SERVICE_PORT=3003

# AUTH DATABASE
AUTH_DB_HOST=goosee-auth-db-dev
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=auth_db

# PAGE SERVICE
PAGE_SERVICE_HOST=goosee-page-service-dev
PAGE_SERVICE_PORT=3004

# PAGE DATABASE
PAGE_DB_HOST=goosee-page-db-dev
PAGE_DB_PORT=5432
PAGE_DB_USER=postgres
PAGE_DB_PASSWORD=postgres
PAGE_DB_NAME=page_db

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com

# MINIO (stockage objet)
MINIO_ENDPOINT=goosee-minio-dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=your-minio-root-user
MINIO_ROOT_PASSWORD=your-minio-root-password
MINIO_BUCKET=goosee-uploads
# URL publique exposée aux clients (via nginx ou directement MinIO)
MINIO_PUBLIC_URL=http://localhost:9000

# MAILHOG (email dev — ne pas utiliser en production)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ADMINER (interface DB dev)
ADMINER_PORT=8080
