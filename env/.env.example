NODE_ENV=development

# NEXT JS
NEXT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# API GATEWAY
API_GATEWAY_PORT=3001

# API INTERNE (control plane <-> tenant) — jeton partagé pour /internal/*
INTERNAL_API_TOKEN=dev_internal_token_change_me

# PROVISIONING (renseigné par l'orchestrateur, par tenant)
# PROVISION_TENANT_URL=https://slug.anaduck.fr
# PROVISION_CALLBACK_URL=http://orchestrateur:4000/tenants/<id>/status
# INIT_USER_EMAIL=client@example.com   # mot de passe owner généré si non fourni

# RABBIT MQ (infra Docker exposée sur l'hôte)
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# USER SERVICE (natif)
USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=3002
USER_DB_HOST=localhost
USER_DB_PORT=5434
USER_DB_USER=postgres
USER_DB_PASSWORD=postgres
USER_DB_NAME=user_db

# AUTH SERVICE (natif)
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3003
JWT_SECRET=dev_jwt_secret_change_me
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_me
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5433
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=auth_db

# PAGE SERVICE (natif)
PAGE_SERVICE_HOST=localhost
PAGE_SERVICE_PORT=3004
PAGE_DB_HOST=localhost
PAGE_DB_PORT=5435
PAGE_DB_USER=postgres
PAGE_DB_PASSWORD=postgres
PAGE_DB_NAME=page_db

# LOG SERVICE (natif)
LOG_SERVICE_HOST=localhost
LOG_SERVICE_PORT=3005
LOG_DB_HOST=localhost
LOG_DB_PORT=5436
LOG_DB_USER=postgres
LOG_DB_PASSWORD=postgres
LOG_DB_NAME=log_db

# PRODUCT SERVICE (natif)
PRODUCT_SERVICE_HOST=localhost
PRODUCT_SERVICE_PORT=3006
PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5437
PRODUCT_DB_USER=postgres
PRODUCT_DB_PASSWORD=postgres
PRODUCT_DB_NAME=product_db

# ORDER SERVICE (natif)
ORDER_SERVICE_HOST=localhost
ORDER_SERVICE_PORT=3007
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5438
ORDER_DB_USER=postgres
ORDER_DB_PASSWORD=postgres
ORDER_DB_NAME=order_db

# CART SERVICE (natif)
CART_SERVICE_HOST=localhost
CART_SERVICE_PORT=3008
CART_DB_HOST=localhost
CART_DB_PORT=5439
CART_DB_USER=postgres
CART_DB_PASSWORD=postgres
CART_DB_NAME=cart_db

# PAYMENT SERVICE (natif)
PAYMENT_SERVICE_HOST=localhost
PAYMENT_SERVICE_PORT=3009
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5441
PAYMENT_DB_USER=postgres
PAYMENT_DB_PASSWORD=postgres
PAYMENT_DB_NAME=payment_db
# Stripe (mode test) — laisser vide active le provider en mode mock (aucun paiement reel)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cle publique Stripe (test), exposee au front (inlinee au build Next.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# TICKET SERVICE (natif) — ports reattribues (3007/5438 pris par order-service)
TICKET_SERVICE_HOST=localhost
TICKET_SERVICE_PORT=3010
TICKET_DB_HOST=localhost
TICKET_DB_PORT=5442
TICKET_DB_USER=postgres
TICKET_DB_PASSWORD=postgres
TICKET_DB_NAME=ticket_db

# STOCK SERVICE
STOCK_SERVICE_HOST=localhost
STOCK_SERVICE_PORT=3011
STOCK_DB_HOST=localhost
STOCK_DB_PORT=5443
STOCK_DB_USER=postgres
STOCK_DB_PASSWORD=postgres
STOCK_DB_NAME=stock_db
# Duree de reservation (checkout) avant liberation automatique par le job de purge
STOCK_RESERVATION_TTL_MINUTES=30

# SMTP (Mailhog en dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@goosee.local

# ADMINER
ADMINER_PORT=8080

# MINIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_BUCKET=goosee-uploads
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# MAILHOG
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025

# PRESENTATION (yarn presentation) — sous-ensemble reellement deploye + peuple.
# Nombre de sites K8s de Bob (0-4) et de sites Docker (1-2). Sur un portable 16 Go,
# 1 Docker + 2 K8s tient avec les requests reduites du chart Helm.
PRESENTATION_DOCKER_COUNT=1
PRESENTATION_K8S_COUNT=2

# ASSISTANT SERVICE (chatbot d'aide base sur docs/guide-utilisateur.md)
ASSISTANT_SERVICE_HOST=localhost
ASSISTANT_SERVICE_PORT=3012
# Cle gratuite : https://aistudio.google.com/apikey (aucune carte bancaire requise)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
