  "info": {
    "_postman_id": "e8b2d57a-2d6a-4e12-9e66-7cc5bbf3a111",
    "name": "Goosee - API Gateway Endpoints",
    "description": "Collection API Gateway avec setup automatique des tokens par role.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const roleHeader = pm.request.headers.get('x-role');",
          "if (!roleHeader) {",
          "  pm.request.headers.remove('Authorization');",
          "  return;",
          "}",
          "const role = String(roleHeader).toLowerCase();",
          "const tokenMap = {",
          "  owner: pm.environment.get('owner_access_token') || '',",
          "  manager: pm.environment.get('manager_access_token') || '',",
          "  customer: pm.environment.get('customer_access_token') || ''",
          "};",
          "const token = tokenMap[role];",
          "if (!token) {",
          "  console.warn(`No token found for role=${role}. Run setup logins first.`);",
          "  pm.request.headers.remove('Authorization');",
          "  return;",
          "}",
          "pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "Login Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const j = pm.response.json();",
                  "  const access = j.accessToken || '';",
                  "  pm.environment.set('owner_access_token', access);",
                  "  pm.environment.set('owner_refresh_token', j.refreshToken || '');",
                  "  if (access) {",
                  "    try {",
                  "      const base64 = access.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "      const payload = JSON.parse(atob(base64));",
                  "      if (payload?.sub) pm.environment.set('owner_auth_id', payload.sub);",
                  "    } catch (e) {",
                  "      console.warn(`Unable to decode JWT payload: ${e?.message || e}`);",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
