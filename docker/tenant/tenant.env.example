# Variables d'un tenant. L'orchestrateur génère ce fichier par tenant (secrets aléatoires
# non par défaut, sinon les garde-fous de prod refusent le démarrage), puis lance :
#   docker compose -p tenant-<slug> --env-file <ce fichier> -f docker-compose.tenant.yml up -d
TENANT_SLUG=demo

# Secrets JWT (générés)
JWT_SECRET=remplacer-par-un-secret-aleatoire
JWT_ACCESS_SECRET=remplacer-par-un-secret-aleatoire
JWT_REFRESH_SECRET=remplacer-par-un-secret-aleatoire
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Jeton interne control plane <-> tenant (généré)
INTERNAL_API_TOKEN=remplacer-par-un-jeton-aleatoire

# Mot de passe des bases du tenant (généré, jamais "postgres")
DB_PASSWORD=remplacer-par-un-mot-de-passe-aleatoire

# Identifiants MinIO du tenant (générés, jamais "minioadmin")
MINIO_ROOT_USER=remplacer-par-un-identifiant
MINIO_ROOT_PASSWORD=remplacer-par-un-mot-de-passe-aleatoire
