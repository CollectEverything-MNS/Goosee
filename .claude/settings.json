{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn lint)",
      "Bash(yarn format)",
      "Bash(yarn test)",
      "Bash(yarn build)",
      "Bash(yarn install:project)",
      "Bash(yarn dev)",
      "Bash(yarn infra:status)",
      "Bash(yarn infra:logs)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(docker compose ps:*)"
    ],
    "deny": [
      "Read(./env/.env.dev)",
      "Read(./env/.env.prod)",
      "Read(./env/.env.local)"
    ]
  }
}
